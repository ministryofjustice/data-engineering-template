# Production-ready Dockerfile for FastAPI/Python applications
# Built for deployment to Kubernetes/Cloud Platform
#
# Uses Ministry of Justice approved base image for consistency
#
# Build: docker build -f Dockerfile.api -t my-app:latest .
# Run:   docker run -p 8000:8000 my-app:latest

# Base image: MoJ Analytical Platform Python base
FROM ghcr.io/ministryofjustice/analytical-platform-airflow-python-base:1.50.0@sha256:b7e2c0ea1e0758a7ba736797350817466a6c5dad15e0b0b7a3c1c3c2096fef13 as base

ARG MOJAP_IMAGE_VERSION="default"
ENV MOJAP_IMAGE_VERSION=${MOJAP_IMAGE_VERSION}

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

COPY pyproject.toml uv.lock ./

RUN uv venv /app/.venv --python 3.14

ENV PATH="/app/.venv/bin:$PATH"
RUN uv pip install --no-cache -r <(uv pip compile pyproject.toml)

COPY src/ /app/src/

RUN chown -R analyticalplatform:analyticalplatform /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ENVIRONMENT=production

USER analyticalplatform

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import http.client; c = http.client.HTTPConnection('localhost', 8000); c.request('GET', '/health'); exit(0 if c.getresponse().status == 200 else 1)" || exit 1

# ENTRYPOINT ["python", "-m", "src.template.main"]

ENTRYPOINT ["python", "-m", "uvicorn", "src.template.app:app", "--host", "0.0.0.0", "--port", "8000"]

# ENTRYPOINT ["python", "-m", "src.template.main"]
